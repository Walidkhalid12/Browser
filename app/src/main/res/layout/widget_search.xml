<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_pill" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="6dp">
    <ImageView android:id="@+id/w_logo" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/wi_dot" android:tint="@color/w_fg" android:padding="4dp" />
    <TextView android:id="@+id/w_text" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical"
        android:paddingStart="10dp" android:text="Search or type a URL" android:textColor="@color/w_dim" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    <ImageView android:id="@+id/w_mic" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:src="@drawable/wi_mic" android:tint="@color/w_fg" android:contentDescription="Voice search" />
</LinearLayout>