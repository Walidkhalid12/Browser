<resources>
    <style name="Theme.Browser" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Context theme for WebViews when "Dark pages" is on: a dark theme lets the engine darken sites. -->
    <style name="Theme.Browser.WebDark" parent="android:Theme.Material.NoActionBar" />
</resources>
